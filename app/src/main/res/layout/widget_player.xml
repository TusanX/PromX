<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_player_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="PromX"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="点击打开播放器"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_previous"
        android:layout_width="44dp"
        android:layout_height="48dp"
        android:contentDescription="上一首"
        android:gravity="center"
        android:text="‹"
        android:textColor="#FFFFFFFF"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/widget_play"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/widget_player_action"
        android:contentDescription="播放或暂停"
        android:gravity="center"
        android:text="▶"
        android:textColor="#FF18181B"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/widget_next"
        android:layout_width="44dp"
        android:layout_height="48dp"
        android:contentDescription="下一首"
        android:gravity="center"
        android:text="›"
        android:textColor="#FFFFFFFF"
        android:textSize="30sp" />
</LinearLayout>
